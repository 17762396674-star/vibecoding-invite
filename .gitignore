node_modules/
.DS_Store
Thumbs.db
desktop.ini

# 环境变量与密钥
.env
.env.*
*.pem
*.key

# 本地笔记 / 草稿（如果你把文档放在项目里，也不会被推上去）
notes/
drafts/
*.local.md
